<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RuWen" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryDark">@color/purple_dark</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/teal_accent</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        <item name="colorAccent">@color/purple_primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/purple_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background</item>
        <!-- 弹出菜单统一走这一套：白色圆角底 + 不与锚点重叠 + 从按钮下方 4dp 展开。
             `popupMenuStyle` 管代码创建的菜单，`actionOverflowMenuStyle` 管工具栏系统溢出菜单，
             两者指向同一个父样式，保证全项目菜单底色一致。
             （早年只在两个布局上挂 app:popupTheme，其余页面没挂 —— 于是出现过三种底色。） -->
        <item name="popupMenuStyle">@style/Widget.RuWen.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.RuWen.PopupMenu.Overflow</item>
    </style>

    <!-- 弹出菜单：白底 / 不与锚点重叠 / 从锚点下方 4dp 展开 -->
    <style name="Widget.RuWen.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>

    <style name="Widget.RuWen.PopupMenu.Overflow" parent="Widget.RuWen.PopupMenu" />

    <style name="PlayerTheme" parent="Theme.RuWen">
        <item name="android:windowBackground">@color/player_background</item>
    </style>

</resources>
