<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RuWen" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryDark">@color/purple_dark</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/teal_accent</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        <item name="colorAccent">@color/purple_primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/purple_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background</item>
        <!-- 溢出菜单（工具栏右上角三点）必须弹到按钮**下方**，不许盖住按钮。
             AppCompat/Material3 的溢出菜单默认 overlapAnchor=true（面板压在锚点上），
             播放列表详情页「三点弹框遮盖按钮」的根因即此。这里主题级关闭后，
             所有页面的系统溢出菜单行为一致（与列表项上自定义 PopupMenu 的下弹表现相同）。 -->
        <item name="actionOverflowMenuStyle">@style/Widget.RuWen.PopupMenu.Overflow</item>
    </style>

    <!-- 溢出菜单：不与锚点重叠 + 少量垂直偏移，视觉上「从按钮下方展开」 -->
    <style name="Widget.RuWen.PopupMenu.Overflow" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>

    <style name="PlayerTheme" parent="Theme.RuWen">
        <item name="android:windowBackground">@color/player_background</item>
    </style>

    <!-- 溢出菜单（如「字幕识别模型」）：浅色弹窗 + 深色文字，避免白底白字 -->
    <style name="ThemeOverlay.RuWen.PopupMenu" parent="ThemeOverlay.Material3.Light">
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="popupMenuBackground">@color/background</item>
    </style>
</resources>
