<?xml version="1.0" encoding="utf-8"?>
<!-- 音频列表页（播放列表详情）的工具栏菜单：只放一个「三点」按钮，
     点击后用 RuwenMenu 弹出「选择 / 排序」两项。

     为什么不再用系统溢出菜单（showAsAction="never"）：
     系统溢出菜单的图标只能渲染在**左侧**，与全项目「图标右置」的菜单风格不一致；
     改成普通 action 按钮后由 RuwenMenu 统一渲染，风格与首页 / 主页面菜单完全一致。
     （toolbar 上有 always 项时系统才不显示溢出三点，这里正好用 always 接管。） -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_more"
        android:icon="@drawable/ic_more_vert"
        android:title="@string/more"
        app:showAsAction="always" />

</menu>
