<?xml version="1.0" encoding="utf-8"?>
<!-- 静态圆形描边按钮（播客单集右侧的下载 / 删除按钮）。
     参考 AntennaPod 的 secondary action：圆环 + 居中图标。
     这里只做**静态描边**，不画进度环——下载进度不在列表里展示。
     描边与图标都用 ?attr/colorControlNormal，跟随主题走黑白灰，不用主题紫。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/surface_variant" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorControlNormal" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorControlNormal" />
        </shape>
    </item>
</selector>
