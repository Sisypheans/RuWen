<?xml version="1.0" encoding="utf-8"?>
<!-- 播客详情页（排版参照 AntennaPod 的 feeditemlist）：
     工具栏（固定）+ 单集列表；**播客头部作为列表第一项**（见 item_podcast_header.xml），
     随列表一起滚动、不固定，所以这里不再有独立的头部区域。
     底部 = 迷你播放栏；多选状态时，其上方浮出多选操作栏（全选 / 下载 / 删除 / 取消）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_primary"
        android:elevation="6dp"
        app:liftOnScroll="false"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/purple_primary"
            app:titleTextColor="@color/text_on_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/episodeRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/list_bottom_padding" />

    <!-- 多选操作栏：长按单集后显示 -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone"
        android:background="@color/background">

        <Button
            android:id="@+id/btnSelectAll"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/select_all" />

        <Button
            android:id="@+id/btnDownloadSelected"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/download" />

        <Button
            android:id="@+id/btnDeleteSelected"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/delete" />

        <Button
            android:id="@+id/btnCancelSelection"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/cancel" />

    </LinearLayout>

    <include
        layout="@layout/mini_player"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mini_player_height" />

</LinearLayout>
