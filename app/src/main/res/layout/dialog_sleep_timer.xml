<?xml version="1.0" encoding="utf-8"?>
<!-- 睡眠定时底部弹窗。
     参考主流播放器（Spotify / YouTube Music / 播客类 App）分为两类定时：
       1) 倒计时定时：N 分钟后暂停；
       2) 本集结束后停止：播完当前音频即暂停。
     已生效时显示剩余时间，并提供「关闭定时」。 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sleep_timer"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 当前生效中的定时，未生效时隐藏 -->
    <TextView
        android:id="@+id/tvTimerActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/purple_primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/sleep_timer_preset_title"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleLine="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/minutes_15"
            android:textColor="@color/purple_primary"
            app:chipBackgroundColor="@color/purple_100"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/minutes_30"
            android:textColor="@color/purple_primary"
            app:chipBackgroundColor="@color/purple_100"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip45"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/minutes_45"
            android:textColor="@color/purple_primary"
            app:chipBackgroundColor="@color/purple_100"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/minutes_60"
            android:textColor="@color/purple_primary"
            app:chipBackgroundColor="@color/purple_100"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip90"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/minutes_90"
            android:textColor="@color/purple_primary"
            app:chipBackgroundColor="@color/purple_100"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip120"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/minutes_120"
            android:textColor="@color/purple_primary"
            app:chipBackgroundColor="@color/purple_100"
            app:chipStrokeWidth="0dp" />

    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etCustomMinutes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ems="10"
            android:hint="@string/custom"
            android:inputType="number" />

        <Button
            android:id="@+id/btnCustom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/confirm" />

    </LinearLayout>

    <Button
        android:id="@+id/btnCancelTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/sleep_timer_off"
        style="@style/Widget.Material3.Button.OutlinedButton" />

</LinearLayout>
